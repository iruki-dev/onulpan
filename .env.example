# ── 공통 ──────────────────────────────────────────────
ONULPAN_ENV=production            # production이면 개발용 로그인·시드가 막히고, API 키 외 인증 수단이 있으면 워커가 시작하지 않는다
ONULPAN_MODE=beta                 # beta | launch (config/*.yaml). 코드는 같고 설정값만 다르다
ONULPAN_SECRET=                   # 세션·수신 거부 링크 서명. 웹과 워커가 같은 값을 쓴다 (openssl rand -hex 32)
SITE_URL=https://onulpan.kr
ONULPAN_BUDGET_USD=30             # LLM 월 예산 상한 (80% 알림, 100% 제출 중단). 비우면 모드 기본값

# ── 워커 (app_writer) ─────────────────────────────────
DATABASE_URL=postgresql://onulpan_worker:CHANGE_ME@localhost:5432/onulpan
ANTHROPIC_API_KEY=                # 파이프라인은 반드시 API 키로 호출한다 (구독 계정·무료 체험 API를 연결하지 않는다)
ONULPAN_EMBEDDER=bge-m3           # bge-m3 | hashing (개발용)
DATA_GO_KR_SERVICE_KEY=           # 정책브리핑 정책뉴스 API (공공데이터포털)
EMAIL_BACKEND=ses                 # ses | console(개발: var/outbox에 .eml)
SES_SMTP_HOST=email-smtp.ap-northeast-2.amazonaws.com
SES_SMTP_PORT=587
SES_SMTP_USER=
SES_SMTP_PASS=
IMAGE_DIR=/opt/onulpan/var/images # 이미지 원본·표시용 파일 (웹과 워커가 같은 경로를 쓴다)
IMAGE_FONT=                       # 자체 그래픽 한글 글꼴. 비우면 fonts-noto-cjk를 찾는다
UNSPLASH_ACCESS_KEY=              # 무료 스톡 (없으면 그 출처는 건너뛴다)
PEXELS_API_KEY=
PIXABAY_API_KEY=
TELEGRAM_BOT_TOKEN=               # 알림 네 가지. 없으면 ALERT_EMAIL로
TELEGRAM_CHAT_ID=
ALERT_EMAIL=

# ── 백업 (Cloudflare R2, S3 호환) ─────────────────────
R2_ACCOUNT_ID=
R2_BUCKET=onulpan-backup
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── 웹 (app_reader) ───────────────────────────────────
DATABASE_URL_WEB=postgresql://onulpan_web:CHANGE_ME@localhost:5432/onulpan
IMAGE_DIR=/opt/onulpan/var/images # 위와 같은 값 (/img/[id]가 여기서 읽는다)
ADMIN_EMAILS=                     # 관리 화면에 들어올 수 있는 이메일 (쉼표 구분)
FOUNDER_NAME=                     # 편집 원칙의 기사배열책임자·청소년보호책임자
FOUNDER_EMAIL=
BETA_LAUNCH_DATE=                 # 편집 원칙 개정 이력 v1 날짜
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TOSS_CLIENT_KEY=                  # 창립 멤버 선결제 (토스페이먼츠)
TOSS_SECRET_KEY=
FOUNDING_PRICE_KRW=39000
DEV_LOGIN=0                       # 1이면 이메일 입력만으로 로그인 (ONULPAN_ENV=production에서는 무시)
